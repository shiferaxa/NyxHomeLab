# Copy this file to terraform.tfvars and set values
# Secrets must go into secrets.tfvars (gitignored)

# Proxmox API
api_url      = "https://athena.rohu-atria.ts.net:8006/api2/json"

# VM template and storage
template_name = "ubuntu-2404-template"
storage_name  = "local-lvm"   # e.g., local-lvm or your storage name

# Networking
nic_name = "vmbr0"
# vlan_num = 123            # uncomment to tag VLAN

# Cloud-init
ssh_user = "ubuntu"
# Provide an SSH public key (ssh-ed25519 or ssh-rsa). Leave empty to skip.
# ssh_key = "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAA... user@host"

# Kubernetes topology
k8s_master_node = "aries"
k8s_worker_node = "athena"
k8s_worker_count = 2
master_memory = 4096
worker_memory = 2048
master_cores  = 2
worker_cores  = 2
