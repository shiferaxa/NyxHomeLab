# Copy to hosts.yml and fill in IPs from: ./scripts/tf.sh output k8s_nodes
all:
  vars:
    ansible_user: ubuntu
    ansible_ssh_private_key_file: ~/.ssh/id_ed25519
    k8s_version: "1.31"
    pod_cidr: "10.244.0.0/16"
  children:
    control_plane:
      hosts:
        k8s-master:
          ansible_host: 192.168.1.10
    workers:
      hosts:
        k8s-worker-1:
          ansible_host: 192.168.1.11
        k8s-worker-2:
          ansible_host: 192.168.1.12
